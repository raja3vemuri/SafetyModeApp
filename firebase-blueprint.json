{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile information stored upon authentication",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Unique Firebase user identifier"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Email address of the authenticated user"
        },
        "displayName": {
          "type": "string",
          "maxLength": 120,
          "description": "Display name of the user"
        },
        "photoURL": {
          "type": "string",
          "description": "Profile picture URL"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp when the user profile was created"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp when the profile was last updated"
        }
      },
      "required": ["userId", "email"]
    },
    "SignatureRecord": {
      "title": "SignatureRecord",
      "description": "A saved email signature record belonging to a user",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique signature document ID"
        },
        "userId": {
          "type": "string",
          "description": "User ID of the signature owner"
        },
        "title": {
          "type": "string",
          "maxLength": 100,
          "description": "Descriptive title for this saved signature"
        },
        "template": {
          "type": "string",
          "enum": ["classic", "minimal", "corporate-logo", "social", "executive"],
          "description": "Selected signature archetype"
        },
        "personal": {
          "type": "object",
          "description": "Signee personal details and portrait"
        },
        "company": {
          "type": "object",
          "description": "Organization details and corporate logo"
        },
        "style": {
          "type": "object",
          "description": "Styling colors, typography, toggles, calendar URL and disclaimer"
        },
        "socials": {
          "type": "array",
          "description": "List of active social media platform links"
        },
        "isDefault": {
          "type": "boolean",
          "description": "Whether this is the user's active/default signature"
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "description": "Last modified timestamp"
        }
      },
      "required": ["id", "userId", "template", "personal", "company", "style"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Root user profile document"
    },
    "/users/{userId}/signatures/{signatureId}": {
      "schema": {
        "$ref": "#/entities/SignatureRecord"
      },
      "description": "User's saved email signature templates and presets"
    }
  }
}
